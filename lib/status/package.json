{
  "name": "@dsh-external/dsh-layered-memory-status",
  "version": "0.10.0-preview.30",
  "type": "module",
  "main": "index.js",
  "description": "会话输入区的记忆维护活动、固定会话与只读历史。",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "status-contract.js",
    "client.js",
    "locale",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5 || 4.0.5-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "@deepseek-ai/dsh-api-gateway/client"
      ]
    }
  }
}
