{
  "name": "@dsh-external/dsh-layered-memory",
  "version": "0.11.0",
  "description": "DSH 跨会话记忆：项目与全局视图、结构化条目标识、证据溯源、可恢复历史及按需维护。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src/*.js",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "docs",
    "templates",
    "scripts/e2e-log-report.mjs",
    "scripts/e2e-heat.mjs",
    "client",
    "scripts/build.mjs"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check:lib": "node --check lib/index.js",
    "check": "npm run build",
    "e2e:report": "node scripts/e2e-log-report.mjs",
    "e2e:heat": "node scripts/e2e-heat.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "memory",
    "long-term-memory",
    "agent-skills",
    "cross-session-memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDFXYqiming/dsh-layered-memory.git"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5 || 4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": "* || 3.18.5-alpha.2",
    "@deepseek-ai/dsh-session-query": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "vitest": "^3.2.7"
  },
  "author": "DDDFXYqiming",
  "homepage": "https://github.com/DDDFXYqiming/dsh-layered-memory#readme",
  "icon": "./icon.svg",
  "dependencies": {
    "@dsh-external/dsh-layered-memory-status": "file:./lib/status",
    "zod": "^4.4.3"
  },
  "bundleDependencies": [
    "@dsh-external/dsh-layered-memory-status"
  ]
}
