{
  "name": "@dsh-external/dsh-layered-memory",
  "version": "0.9.0",
  "description": "DSH 跨会话记忆：项目与全局视图、结构化条目标识、证据溯源、可恢复历史及按需维护。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src/*.js",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "docs",
    "templates",
    "scripts/e2e-log-report.mjs"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('node:fs'),cp=require('node:child_process');for(const f of ['lib/index.js',...fs.readdirSync('src').filter(f=>f.endsWith('.js')).map(f=>'src/'+f)])cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "check:lib": "node --check lib/index.js",
    "check": "npm run build",
    "e2e:report": "node scripts/e2e-log-report.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "memory",
    "long-term-memory",
    "agent-skills",
    "cross-session-memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DDDFXYqiming/dsh-layered-memory.git"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5 || 4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "* || 0.2.1-alpha.3",
    "@deepseek-ai/schemastery": "* || 3.18.5-alpha.2",
    "@deepseek-ai/dsh-session-query": "* || 0.2.1-alpha.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-sandbox": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-scope": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": "^0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "vitest": "^3.2.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    }
  },
  "author": "DDDFXYqiming",
  "homepage": "https://github.com/DDDFXYqiming/dsh-layered-memory#readme",
  "icon": "./icon.svg"
}
